{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "treinai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "treinai-db",
      "database_id": "34c1de17-f7dc-4cbf-8b53-abf914eef73c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "treinai-photos"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "triggers": {
    // Lembretes de água e de treino (horários no fuso de cada usuário, ver src/lib/reminders.ts)
    "crons": ["0 * * * *"]
  },
  "vars": {
    "APP_URL": "https://treinai-taupe.vercel.app",
    "VAPID_SUBJECT": "mailto:fabriccioarts@gmail.com",
    // Dias de teste grátis com a IA liberada; depois, só com assinatura (src/lib/billing.ts)
    "TRIAL_DAYS": "3",
    // Ids das ofertas na Cakto (o final do link pay.cakto.com.br/<id>); vazio = checkout desligado
    "CAKTO_OFFER_MENSAL": "3esbaq9_1222082",
    "CAKTO_OFFER_TRIMESTRAL": "8g6hp4p",
    // Remetente dos e-mails (Resend). O onboarding@resend.dev só entrega para o dono da conta Resend:
    // troque por um endereço do seu domínio verificado no Resend (ex.: "Théo do Treinai <theo@seudominio.com>")
    "EMAIL_FROM": "Treinai <onboarding@resend.dev>"
  }
  // Segredos da Cakto (wrangler secret put): CAKTO_WEBHOOK_SECRET (obrigatório),
  // CAKTO_CLIENT_ID e CAKTO_CLIENT_SECRET (opcionais: cancelar a assinatura pelo app)
}
